# Copie para `.env` e preencha. O `.env` é lido automaticamente por config.py.

# Chave da API do The Movie Database (https://www.themoviedb.org/settings/api).
# Sem ela, os filmes usam o placeholder (gradiente + inicial do título).
TMDB_API_KEY=f7a442a28c676fea13d6513c54ebc0d7

# Segundos de countdown antes do auto-start quando ≥2 jogadores estão no lobby (padrão: 30).
AUTO_START_SECONDS=30

# Portas seriais dos Arduinos (totens LED). Deixe vazio para desabilitar.
# Exemplos macOS: /dev/cu.usbmodem1401  /dev/cu.usbmodem1402
ARDUINO_A_PORT=/dev/cu.usbmodem1401
ARDUINO_B_PORT=/dev/cu.usbmodem1402
ARDUINO_BAUD=9600
